// part: metadata

[tags]
partial-support = true
caveats = ["Nanosecond TIME input must be microsecond-aligned; MonetDB returns microseconds."]

// part: input

{"idx":0,"value":0}
{"idx":1,"value":3661000000000}
{"idx":2,"value":43200000000000}
{"idx":3,"value":49531123456000}
{"idx":4,"value":86399999999000}
{"idx":5,"value":null}

// part: expected_schema

{"format":"+s","children":[{"name":"idx","format":"l","flags":["nullable"]},{"name":"value","format":"ttu","flags":["nullable"]}]}

// part: expected

{"idx":0,"value":0}
{"idx":1,"value":3661000000}
{"idx":2,"value":43200000000}
{"idx":3,"value":49531123456}
{"idx":4,"value":86399999999}
{"idx":5,"value":null}
