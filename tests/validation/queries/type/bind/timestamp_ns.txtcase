// part: metadata

[tags]
partial-support = true
caveats = ["Nanosecond TIMESTAMP input must be microsecond-aligned; MonetDB returns microseconds."]

// part: setup_query

CREATE TABLE test_timestamp (
    idx INT,
    res TIMESTAMP(6)
);

// part: bind

{"idx": 3, "res": 1684158330000000000}
{"idx": 2, "res": 946684800000000000}
{"idx": 1, "res": -9223372036854775000}
{"idx": 4, "res": 9223372036854775000}
{"idx": 0, "res": null}

// part: expected_schema

{"format":"+s","children":[{"name":"res","format":"tsu:","flags":["nullable"]}]}

// part: expected

{"res": null}
{"res": -9223372036854775}
{"res": 946684800000000}
{"res": 1684158330000000}
{"res": 9223372036854775}
